# Copia este archivo como `.env` y rellena los valores.
# `.env` está en .gitignore: NUNCA se sube a GitHub.
#
# Brevo — https://app.brevo.com
#   1. Settings > Senders: verifica el remitente (correo de la Fundación).
#   2. Settings > SMTP & API > API Keys & MCP > Generate a new API key
#      (acceso Restringido > Emails transaccionales: Todos).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=fundacioncalidad.org2026@gmail.com
